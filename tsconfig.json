{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "agents/**/*.ts",
    "lib/**/*.ts",
    "evals/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
