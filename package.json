{
  "name": "pyme-factoring-agent",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#lib/*": "./lib/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev --agent asesor",
    "eval": "eve eval --agent asesor && eve eval --agent copiloto",
    "start": "eve start",
    "typecheck": "tsc",
    "test": "node --test \"tests/**/*.test.ts\"",
    "dev:web": "next dev apps/web",
    "build:web": "next build apps/web",
    "dev:eve": "eve dev --agent asesor",
    "dev:all": "vercel dev --local",
    "metricas:evals": "node scripts/exportar-evals.ts",
    "metricas:telemetria": "node scripts/exportar-telemetria.ts --key-name prototipo-banca",
    "metricas:dominio": "node scripts/exportar-dominio.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@shadcn/react": "^0.3.1",
    "@shikijs/core": "^3.23.0",
    "@shikijs/engine-javascript": "^3.23.0",
    "@shikijs/engine-oniguruma": "^3.23.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@vercel/connect": "2.7.0",
    "ai": "^7.0.137",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eve": "^1.0.0-rc.9",
    "jose": "^6.2.17",
    "lucide-react": "^1.16.0",
    "nanoid": "^5.1.11",
    "next": "^16.4.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.0",
    "shiki": "^3.23.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "just-bash": "^3.6.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
